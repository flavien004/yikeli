# Copier vers .env (local) et renseigner les MÊMES variables dans Netlify.
# Jamais de préfixe VITE_ : ces valeurs doivent rester côté serveur.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images

# Secret de signature des JWT : 32 caractères minimum, aléatoire.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Durées (secondes) — valeurs par défaut : 15 min / 7 jours
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Utilisés uniquement par `npm run create-admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
